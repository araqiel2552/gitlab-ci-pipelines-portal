@page "/account/sign-in"
@attribute [AllowAnonymous]
@layout MainLayout

<PageTitle>Sign in | Pipeline Portal</PageTitle>

<div class="card-surface" style="max-width:420px; margin:3rem auto; padding:1.5rem">
    <h1>Sign in</h1>
    <p class="muted">Development sign-in. In production the portal delegates authentication to Okta.</p>

    @if (Error == "1")
    {
        <div class="alert-gl alert-gl-error">Unknown or disabled account.</div>
    }

    <form method="post" action="account/dev-login" class="form-grid">
        <AntiforgeryToken />
        <input type="hidden" name="returnUrl" value="@(ReturnUrl ?? "/")" />
        <div class="form-field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" required autocomplete="username" />
            <div class="form-hint">The account must already exist in the portal user list.</div>
        </div>
        <button class="btn-gl btn-gl-primary" type="submit">Continue</button>
    </form>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
}
